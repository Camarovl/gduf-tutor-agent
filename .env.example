# ============================================================
# 模型服务配置模板
# 用法：复制本文件为 .env，填入自己的值。.env 已被 .gitignore 排除，不会进仓库。
#      若不用 python-dotenv，也可直接设置为系统环境变量（见 README「快速开始」）。
# 🔴 切勿把真实密钥提交到仓库。
# ============================================================

# ---- 必填三项（当前留空，由使用者填写）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 可选，不填则用代码里的默认值 ----
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.0

# ============================================================
# 参考填法一：本地 LM Studio（推荐开发期使用，零成本）
#   1. 打开 LM Studio → 加载一个模型 → Developer 标签页 → Start Server
#   2. 在 Models 页面查看已加载模型的完整名称
# ------------------------------------------------------------
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=lm                      # 本地服务不校验，任意非空字符串即可
# LLM_MODEL=qwen/qwen3.5-9b           # 🔴 换成你实际加载的模型名
# LLM_MAX_TOKENS=4000                 # 思考型模型必须给足，否则会返回空内容

# ============================================================
# 参考填法二：在线 API（部署到公网时用）
# ------------------------------------------------------------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的密钥
# LLM_MODEL=deepseek-chat

# ============================================================
# ⚠️ 已知坑（实测记录，供排障参考）
# 1. 返回内容为空且 finish_reason=length
#    → 思考型模型把 token 全花在内部推理上了，调大 LLM_MAX_TOKENS 或换模型
# 2. Error rendering prompt with jinja template: "No user query found in messages"
#    → 消息序列以 assistant 开头。本项目已保证以 user 开头；若仍出现，
#      说明该模型的 prompt template 有问题，改用 lmstudio-community 下的同名模型
# 3. 图片上传后报 content 格式错误
#    → 该供应商/模型不支持多模态输入，代码会自动降级为纯文本路径
